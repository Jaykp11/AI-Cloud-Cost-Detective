# Ollama configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=180

# Local PostgreSQL configuration
DATABASE_URL=postgresql://app_user:local_dev_password@localhost:5432/cloud_cost_db

# JWT authentication
JWT_SECRET_KEY=replace-this-with-a-random-secret-before-running
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
FRONTEND_ORIGIN=http://localhost:5173